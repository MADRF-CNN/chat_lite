DATABASE_URL=postgresql://chat:chat-dev-password@localhost:5432/chat_lite?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PORT=3000
NODE_ENV=development
ENFORCE_TLS=false
CLIENT_ORIGIN=http://localhost:5173
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chat-images
S3_ACCESS_KEY=chat
S3_SECRET_KEY=chat-storage-password
S3_FORCE_PATH_STYLE=true
